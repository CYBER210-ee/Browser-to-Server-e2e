# Copy to .env and fill in real values with: python3 generate_keys.py
# No quotes around values. Never commit .env.
SERVER_X25519_PRIVATE_KEY_HEX=9846a9bfca82a5eb4fa58dcd44e070391d5aa2050e2e5a242f810abaedc88279
SERVER_ED25519_PRIVATE_KEY_HEX=d3f744bcd712bee361d054f1acba18ef79cbb9cb0487e298a5f191c8f9e81581

# ── ADR 212: stored history ───────────────────────────────────────────────────
# Must match echovault-deploy/echo_db/.env; host `db` is the compose service.
DATABASE_URL=postgresql://echovault:change-me@db:5432/echovault?sslmode=verify-full
EPOCH_LENGTH=1h
HISTORY_WINDOW=7d
HISTORY_MAX_RECORDS=500
