# Copy to .env. The Dockerfile bakes .env into the image; compose also passes it.

# Server identity (Ed25519) — mint with:  python generate_keys.py
# No static X25519 key: every connection mints its own recipient key (D026).
# A leftover SERVER_X25519_PRIVATE_KEY_HEX in an older .env is ignored.
SERVER_ED25519_PRIVATE_KEY_HEX=

# ── ADR 212: stored history ───────────────────────────────────────────────────
# Must match echo_db/.env (user / password / db). Host `db` is the compose
# service; use the real hostname if the database runs on another box, and make
# sure gen-db-certs.sh listed that hostname in SAN_HOSTS. verify-full is mandatory.
DATABASE_URL=postgresql://echovault:change-me@db:5432/echovault?sslmode=verify-full
# DB_SSLROOTCERT and EPOCH_DB_PATH are set by docker-compose.yml.

# Retention (protocol §9.5): new epoch key every EPOCH_LENGTH; a record is
# unrecoverable once its epoch is HISTORY_WINDOW old. Units: s m h d.
EPOCH_LENGTH=1h
HISTORY_WINDOW=7d
HISTORY_MAX_RECORDS=500
