# Copy to server/.env. Read by uvicorn on the host and by docker compose (env_file);
# nothing is baked into the image.

# Server identity (Ed25519) — mint with:  python generate_keys.py
# No static X25519 key: every connection mints its own recipient key (D026).
SERVER_ED25519_PRIVATE_KEY_HEX=

# History records (ADR 212). The DSN MUST be verify-full; the CA comes from
# db/certs/db-ca.crt. Keep host `localhost` here: docker-compose.yml overrides
# the host to `db` (DB_HOST) and the CA path, so one .env serves both runs.
# Only the password needs to match db/.env.
DATABASE_URL=postgresql://echovault:change-me@localhost:5432/echovault?sslmode=verify-full
DB_SSLROOTCERT=../db/certs/db-ca.crt
# HISTORY_BACKEND=memory        # dev only: no database, nothing persists

# Sealed epoch keys stay on this host (D024).
EPOCH_DB_PATH=./epoch_keys.sqlite3

# Retention (protocol §9.5): new epoch key every EPOCH_LENGTH; a record is
# unrecoverable once its epoch is HISTORY_WINDOW old. Units: s m h d.
EPOCH_LENGTH=1h
HISTORY_WINDOW=7d
HISTORY_MAX_RECORDS=500

# ADR 3: this server's name (D031) — TLS cert name, and what its records are filed under.
SERVER_NAME=echovault
